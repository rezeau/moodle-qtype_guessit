{
  "$schema": "https://raw.githubusercontent.com/ateeducacion/moodle-playground/refs/heads/main/assets/blueprints/blueprint-schema.json",
  "preferredVersions": { "php": "8.3", "moodle": "5.0" },
  "landingPage": "/",
  "constants": {
    "ADMIN_USER": "admin",
    "ADMIN_PASS": "test",
    "ADMIN_EMAIL": "admin@example.com"
  },
  "steps": [
    {
      "step": "installMoodle",
      "options": {
        "adminUser": "{{ADMIN_USER}}",
        "adminPass": "{{ADMIN_PASS}}",
        "adminEmail": "{{ADMIN_EMAIL}}",
        "siteName": "Guessit Question Type Demo",
        "locale": "en",
        "timezone": "Europe/Madrid"
      }
    },
    { "step": "login", "username": "{{ADMIN_USER}}" },
    {
      "step": "installMoodlePlugin",
      "pluginType": "qbehaviour",
      "pluginName": "guessit",
      "url": "https://github.com/bhect0/moodle-qbehaviour_guessit/archive/refs/heads/main.zip"
    },
    {
      "step": "installMoodlePlugin",
      "pluginType": "qtype",
      "pluginName": "guessit",
      "url": "https://github.com/erseco/moodle-qtype_guessit/archive/refs/heads/main.zip"
    },
    {
      "step": "createCategory",
      "name": "Test Courses"
    },
    {
      "step": "createCourse",
      "fullname": "Guessit Demo Course",
      "shortname": "GUESSIT01",
      "category": "Test Courses",
      "summary": "Demo course for the guessit question type. Create a new question of type 'guessit' inside this course's question bank to try the plugin."
    },
    {
      "step": "createUser",
      "username": "student",
      "password": "test",
      "email": "student@example.com",
      "firstname": "Demo",
      "lastname": "Student"
    },
    {
      "step": "enrolUser",
      "username": "{{ADMIN_USER}}",
      "course": "GUESSIT01",
      "role": "editingteacher"
    },
    {
      "step": "enrolUser",
      "username": "student",
      "course": "GUESSIT01",
      "role": "student"
    },
    { "step": "setLandingPage", "path": "/" }
  ]
}
